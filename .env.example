# Supabase Edge Function environment variables
# Set these via: supabase secrets set KEY=value --project-ref <project-ref>
# NEVER commit a populated .env file — see .gitignore

# Auto-injected by Supabase (do NOT set manually):
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# Mollie payment processor (CPR DPP Tracker reports)
# Use test_ key for dev, live_ key in production secrets only.
MOLLIE_API_KEY=

# Admin dashboard auth (SHA-256 hash of the admin password)
ADMIN_PASSWORD_HASH=
